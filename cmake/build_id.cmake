# Stamps the build's version: the base version from include/lh/version.hpp, plus
# -<short commit> (and -dirty with uncommitted changes) unless this is a release build
# (OPENHOUSE_RELEASE=1: scripts/build-*.sh --release). Runs on every build; writes
# OUT/generated/lh/build_id.h and OUT/VERSION.txt only when they change, and
# OUT/generated/lh/build_time.h (when this build was made, Unix seconds) every time: only the
# driver's version export and the installer include it, so it doesn't rebuild the rest.
#   cmake -DSRC=<repo> -DOUT=<build dir> -P build_id.cmake
file(STRINGS "${SRC}/include/lh/version.hpp" line REGEX "^#define LH_VERSION_BASE \"")
string(REGEX REPLACE ".*\"(.*)\".*" "\\1" base "${line}")
set(suffix "")
set(commit "")
if(NOT "$ENV{OPENHOUSE_RELEASE}" STREQUAL "1")
  find_package(Git QUIET)
  if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" rev-parse --short=7 HEAD
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc ERROR_QUIET)
    if(rc EQUAL 0 AND commit)
      set(suffix "-${commit}")
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" status --porcelain --untracked-files=no
                      OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(changes)
        string(APPEND suffix "-dirty")
      endif()
    else()
      set(commit "")
      set(suffix "-local")
    endif()
  else()
    set(suffix "-local")
  endif()
endif()
set(header "// Generated by cmake/build_id.cmake on every build.\n#define LH_BUILD_SUFFIX \"${suffix}\"\n#define LH_BUILD_COMMIT \"${commit}\"\n")
set(hpath "${OUT}/generated/lh/build_id.h")
set(old "")
if(EXISTS "${hpath}")
  file(READ "${hpath}" old)
endif()
if(NOT old STREQUAL header)
  file(WRITE "${hpath}" "${header}")
endif()
set(vpath "${OUT}/VERSION.txt")
set(text "${base}${suffix}\n")
set(old "")
if(EXISTS "${vpath}")
  file(READ "${vpath}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${vpath}" "${text}")
endif()
# When this build was made: two builds of one version (1.0.4-abc vs 1.0.4-def) are ordered by it,
# without asking GitHub (openhouse-installer). Its own header, so only its two users rebuild.
string(TIMESTAMP now "%s" UTC)
file(WRITE "${OUT}/generated/lh/build_time.h"
     "// Generated by cmake/build_id.cmake on every build.\n#define LH_BUILD_TIME ${now}\n#define LH_BUILD_TIME_STRING \"${now}\"\n")
